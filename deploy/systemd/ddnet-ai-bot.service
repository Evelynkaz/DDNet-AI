# The bot itself ("Muha": `ddnet-ai play --brain hybrid`), task 4.4, D-036. NOT enabled by deploy/install.sh and not
# meant to be enabled for any public server: as shipped it plays on the LOCAL server 127.0.0.1:8303 and nothing else
# (the cgroup firewall at the bottom drops every other address). Install, start and, deliberately, how to point it at
# a public server one day: deploy/README.md, section "Бот под systemd".
#
# Exit codes (docs/formats.md 21.5): 0 = stopped on request (systemctl stop); 3 = kicked, banned, or moved to the
# spectators after playing (moderation, D-016); 4 = could not join / the reconnect budget is spent (D-050, D-058);
# 1 = anything else. 3 and 4 are never retried: RestartPreventExitStatus keeps the unit stopped ("failed") until the
# owner has read the log. Restart=on-failure therefore only ever restarts a crash (a panic, a signal, exit 1), and
# StartLimit* stops a crash loop after 3 starts in 10 minutes.
#
# Task 5.9 (D-089), the web launcher: `--server`, `--name`, `--brain`, `--duration`, `--hybrid-mirror` (D-090: the hybrid's
# opponent model, on/off), `--finish` (task 5.13, D-097: off/target/full, off unless the helper says otherwise), `--wb-smart` and
# `--no-selfkill=` (task 5.15, D-103/D-104 and D-102: on/off and true/false, both off unless the helper says otherwise; the duel switch is
# written in its one-argument form because a bare boolean flag cannot be given an empty argument), `--window-model=` (task 3.17, D-111: the
# opponent-input predictor; the path of the model file, EMPTY = off, which is the default and what the helper writes unless the launch card's
# toggle is on; one argument for the same reason; it also overrides a `window_model` key in settings.toml), `--preinput` (task 3.20b, D-112: the
# server's pre-inputs played in the prediction, on/off, off unless the helper says otherwise; `--finish` also takes `wb`, task 3.18/D-114),
# `--search-threads` (task 5.17, D-125: the hybrid's scoring threads, a digit 1 to 4, 1 unless the helper says otherwise), `--duel-fixes` (task 5.18,
# D-129: the 3.23 duel fixes, one of `off`, `finish`, `static,finish`, off unless the helper says otherwise) and the optional
# `--fly-bundle` come from the environment below. The defaults here are today's: local server, hybrid, no time limit. For a launch
# from the site the root helper (`ddnet-ai launch apply`, ddnet-ai-launch.service) writes /etc/ddnet-ai/bot-launch.env with validated values only (it
# overrides the defaults) and a cgroup drop-in /etc/systemd/system/ddnet-ai-bot.service.d/50-launch.conf (IPAddressAllow). After a
# normal end of a run the stop hook below removes that file, so a later hand start is the plain local default again.
# NO other drop-in may override ExecStart= here: `launch apply` refuses to start while one exists.
#
# The console is off (no stdin, --no-console), but the web control channel is on (control.sock in data/bot, task 5.6): the owner commands the
# bot from the site's Bot tab (closed command list, rate-limited, audited; the one chat it can carry is a line the owner types there, D-094, switched off with --no-owner-chat, owner_chat = false or the marker file data/bot/owner-chat.off). The bot's logs carry tags `c<id>-<hash>`, never other players'
# nicknames (D-067); the bot's own nick is not logged either.
# `--web-names` (D-093, owner's decision under D-040): the bridge to the web unit carries real nicknames, clans and chat text, so the
# password-protected site shows readable chat and a readable scoreboard. The web keeps them in memory only (never on disk, never
# logged, chat is cleared when the source changes); this unit's own log and the report still carry tags only.

[Unit]
Description=DDNet-AI bot (hybrid brain; local server only until the owner opens a public one, D-043)
Documentation=file:///home/ubuntu/aiddnet/DDNet-AI/deploy/README.md
After=network.target ddnet-local.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aiddnet/data
# Fail closed if the binary is missing.
ExecStartPre=/usr/bin/test -x /home/ubuntu/aiddnet/bin/ddnet-ai
# --duration 0: no time limit (the unit runs until it is stopped). --report: the JSON report of the last run (latency,
# counters, the outgoing-message audit: "no chat") is written when the bot stops. The freeze memory, the clips, the
# bridge socket (live.sock, for the web unit) and settings.toml live in ~/aiddnet/data/bot (default paths).
# `${VAR}` is one argument; `$BOT_FLY_ARGS` (no braces) is split at spaces and vanishes when empty (plain hybrid has no bundle).
Environment=BOT_SERVER=127.0.0.1:8303
Environment=BOT_NAME=Muha
Environment=BOT_BRAIN=hybrid
Environment=BOT_DURATION=0
Environment=BOT_HYBRID_MIRROR=on
Environment=BOT_FINISH=off
Environment=BOT_WB_SMART=off
Environment=BOT_NO_SELFKILL=false
Environment=BOT_WINDOW_MODEL=
Environment=BOT_PREINPUT=off
Environment=BOT_SEARCH_THREADS=1
Environment=BOT_DUEL_FIXES=off
EnvironmentFile=-/etc/ddnet-ai/bot-launch.env
ExecStart=/home/ubuntu/aiddnet/bin/ddnet-ai play --server ${BOT_SERVER} --name ${BOT_NAME} --brain ${BOT_BRAIN} --duration ${BOT_DURATION} --hybrid-mirror ${BOT_HYBRID_MIRROR} --finish ${BOT_FINISH} --wb-smart ${BOT_WB_SMART} --no-selfkill=${BOT_NO_SELFKILL} --window-model=${BOT_WINDOW_MODEL} --preinput ${BOT_PREINPUT} --search-threads ${BOT_SEARCH_THREADS} --duel-fixes ${BOT_DUEL_FIXES} $BOT_FLY_ARGS --no-console --web-names --data-dir /home/ubuntu/aiddnet/data --report /home/ubuntu/aiddnet/data/bot/last-report.json
# The stop hook runs as root (`+`), and a failure of it never fails the unit (`-`): it records how the bot ended (kick/ban memory
# for a public server, the status the site shows) and removes the one-run environment file. The binary is the root-owned copy
# that deploy/install-launcher.sh installs.
ExecStopPost=-+/usr/local/libexec/ddnet-ai/ddnet-ai launch exited --data-dir /home/ubuntu/aiddnet/data
# No terminal, no input: the console cannot be reached even by accident.
StandardInput=null
StandardOutput=journal
StandardError=journal
# Plain log lines for the journal (no ANSI colour codes); info level.
Environment=NO_COLOR=1
Environment=RUST_LOG=info
# glibc keeps big buffers in the heap once its dynamic mmap threshold has grown: after a map change to a large block map
# (1244x667 tiles) the bot stayed 160 MiB larger for good. A fixed 128 KiB threshold returns them to the system at once
# (E-009: 34 MiB again after the way back, 3 round trips).
Environment=MALLOC_MMAP_THRESHOLD_=131072
# SIGTERM makes the bot disconnect politely (CLOSE) and write its report; give it time.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=3 4

# --- CPU priority over everything the agents run on this VPS (task 4.14, D-124; measurements: docs/research/cpu-priority.md) ---
# Builds, tests, arenas and training share the 8 vCPUs with the bot. Under that load the bot scored fewer candidates per decision (~14 live
# against ~28 in the arena) and missed its first input slot in 46-59% of the decisions instead of 5.7% (2026-10-08). Soft priorities only: no
# real-time scheduling (RestrictRealtime=true below stays, CPUSchedulingPolicy= is not set).
# Slice= is the setting that counts: the bot runs in a top-level slice of its own with CPUWeight=1000 (deploy/systemd/ddnetaibot.slice, which
# explains why), so it competes with user.slice (the agents) at ten times their weight. It is the closest of the allowed options to the ceiling
# the measurements found (SCHED_RR, forbidden here) and still far from it; it does not bring the bot back to quiet-machine behaviour.
# Set on the service as well: CPUWeight= (systemd.resource-control(5), cgroup v2, 1..10000, default 100) keeps the bot ahead of anything else that
# is ever put in the same cgroup, and Nice= (systemd.exec(5), -20..19, default 0) is the scheduler weight among threads of THIS cgroup only (under
# cgroup v2 it never ranks the bot against other cgroups, so alone it did nothing in the measurements; here it is a cheap extra for the bot's own threads
# against its helpers). -5 is mild (weight 3121 against 1024). A negative Nice= needs CAP_SYS_NICE, which systemd applies as PID 1 before it drops
# the bounding set, so CapabilityBoundingSet= (empty, below) stays empty (checked: the process runs at -5).
# IOWeight= (cgroup v2 io.weight) only takes effect with the BFQ or iocost I/O controller; this VPS's disk has scheduler `none`, so today it changes
# nothing. It is kept as a no-cost default.
Slice=ddnetaibot.slice
CPUWeight=1000
Nice=-5
IOWeight=1000

# --- Hardening (as for ddnet-ai-web.service) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# What the bot writes: its state (freeze memory, clips, bridge socket, settings, report), the daily log, the map cache
# (a map downloaded from the server), and the single-instance lock files (data/run). All four directories must exist
# before the first start (deploy/README.md creates them).
ReadWritePaths=/home/ubuntu/aiddnet/data/bot /home/ubuntu/aiddnet/data/logs /home/ubuntu/aiddnet/data/maps/cache /home/ubuntu/aiddnet/data/run
# What the bot writes (clips, memory, report) is private to the owner.
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
MemoryMax=2G
TasksMax=256
# Kernel-level (cgroup eBPF) backstop, same pattern as ddnet-ai-web.service and ddnet-local.service: whatever the
# command line says, traffic to or from anything but loopback is dropped for this unit's processes. A public game
# server is therefore a deliberate, visible change (a drop-in with IPAddressAllow=<server ip>, deploy/README.md), never
# an edit of --server alone.
IPAddressAllow=127.0.0.0/8 ::1
IPAddressDeny=any

[Install]
# Deliberately no WantedBy=/RequiredBy=: the unit stays "static", so `systemctl enable` does nothing and no boot starts it (D-043).
# Start it by hand.

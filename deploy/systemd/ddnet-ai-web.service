# The bot's own web server (task 5.1's `ddnet-ai web`), behind Caddy (task 5.3). Installed to
# /etc/systemd/system/ddnet-ai-web.service by deploy/install.sh. See deploy/README.md.
#
# Absolute paths and User=ubuntu are hardcoded (not templated) because this deploys to exactly
# one owner-operated VPS with a fixed layout (~/aiddnet/data per CLAUDE.md), unlike
# tools/ddnet-server's install-service.sh, which renders a unit from env-overridable variables.

[Unit]
Description=DDNet-AI web UI (loopback only; Caddy is the public HTTPS hop, task 5.3)
Documentation=file:///home/ubuntu/aiddnet/DDNet-AI/deploy/README.md
After=network.target
# Not a hard dependency (this unit works and is independently testable without Caddy at all —
# task 5.1's own e2e does exactly that) — just ordering, so a fresh boot doesn't have Caddy
# proxying to nothing for the second or two it takes this to come up.
Before=caddy.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aiddnet/data
# Fail closed if the binary is missing (e.g. deploy/install.sh was interrupted before the build
# step finished) instead of systemd retrying a nonexistent exec forever.
ExecStartPre=/usr/bin/test -x /home/ubuntu/aiddnet/bin/ddnet-ai
# Task 5.6: the live view and the bot panel read the running bot (`ddnet-ai play`) through its bridge socket,
# `data/bot/live.sock`; the owner's commands and the friends editor use `data/bot/control.sock` and
# `data/bot/relations.json` (both defaults under --data-dir). `--replay` (the Oracle B corpus shown while there was no
# bot, task 5.2a) conflicts with `--bot-socket` and is dropped: until the bot runs, the "Игра" tab says it is not
# running. To get the replays back, swap `--bot-socket ...` for `--replay <dir>` (the "Бот" tab then has no status).
# Task 5.7: `--demo-socket` is the offline demo (ddnet-ai-flydemo.service, the fly playing an arena): while the live bot is not
# there the «Игра» and «Муха» tabs show it under a badge that says it is not a real game, and the site switches to the bot the
# moment it is up. Commands never go to the demo. The demo's socket lives in data/flydemo, apart from the bot's data/bot (the demo unit cannot see data/bot). The socket need not exist (the web retries; without the demo unit the tabs say
# the bot is not running, as before). Read-only map directories under ProtectHome (the demo's arena is on Copy Love Box).
# Task 5.10: `--ddnet-data` is the DDNet 20.1 data directory whose graphics (game.png, skins/, mapres/, ...) the «Игра» tab draws with, served
# at runtime after login and never copied into git (CC BY-SA 3.0). Read-only under ProtectHome; nothing in ReadWritePaths changes.
ExecStart=/home/ubuntu/aiddnet/bin/ddnet-ai web --listen 127.0.0.1:7788 --data-dir /home/ubuntu/aiddnet/data --trust-proxy --cookie-secure --bot-socket /home/ubuntu/aiddnet/data/bot/live.sock --demo-socket /home/ubuntu/aiddnet/data/flydemo/fly-demo.sock --maps-dir /home/ubuntu/aiddnet/data/ddnet-server/maps --maps-dir /home/ubuntu/aiddnet/data/maps/copy-love-box --maps-dir /home/ubuntu/aiddnet/data/maps/cache --ddnet-data /home/ubuntu/aiddnet/build/ddnet-20.1/build/data
Restart=on-failure
RestartSec=2

# --- Hardening (acceptance criterion 2) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The only three subtrees this process ever writes to (secrets: password hash/session key;
# logs: the daily-rotating audit log — see ddnet-ai's `web_cmd::init_tracing`; bot: task 5.6's friends editor
# writes relations.json (+ its .lock and temporary files) there, next to the bot's own sockets — the web only
# connects to those). All three already exist before this unit's first start (deploy/install.sh pre-creates
# logs/web/ and bot/ (0700); secrets/ was created earlier by `ddnet-ai web-passwd`), so ProtectSystem=strict's
# read-only bind mount of everything else never blocks a subdirectory create *inside* these paths. If bot/ is
# missing the unit fails to start (status 226/NAMESPACE): `mkdir -p -m 700 ~/aiddnet/data/bot`.
# Task 5.9 (D-089): data/launch is where the launcher's request file is written (the status is read from the root-owned /run/ddnet-ai); a root path unit does the
# rest, so this unit still has no way to start or stop anything. It must exist before the first start (deploy/install.sh).
ReadWritePaths=/home/ubuntu/aiddnet/data/secrets /home/ubuntu/aiddnet/data/logs /home/ubuntu/aiddnet/data/bot /home/ubuntu/aiddnet/data/launch
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
# Kernel-level (cgroup eBPF) backstop, same pattern as ddnet-local.service: even if the
# application somehow ended up bound to a wider address than --listen 127.0.0.1:7788 asked for,
# traffic to/from anything but loopback is dropped for this unit's processes regardless.
IPAddressAllow=127.0.0.0/8 ::1
IPAddressDeny=any

[Install]
WantedBy=multi-user.target

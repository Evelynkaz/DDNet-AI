+//! Scratch sampling-profiler markers (task 3.6, NOT part of the final diff).
+use std::sync::atomic::{AtomicU8, Ordering};
+pub static PHASE: AtomicU8 = AtomicU8::new(0);
+pub static CTX: AtomicU8 = AtomicU8::new(0);
+pub struct CtxGuard(u8);
+impl Drop for CtxGuard {
+    fn drop(&mut self) {
+        CTX.store(self.0, Ordering::Relaxed);
+    }
+}
+pub fn ctx(c: u8) -> CtxGuard {
+    let prev = CTX.load(Ordering::Relaxed);
+    CTX.store(c, Ordering::Relaxed);
+    CtxGuard(prev)
+}
+pub struct Guard(u8);
+impl Drop for Guard {
+    #[inline(always)]
+    fn drop(&mut self) {
+        PHASE.store(self.0, Ordering::Relaxed);
+    }
+}
+#[inline(always)]
+pub fn enter(p: u8) -> Guard {
+    let prev = PHASE.load(Ordering::Relaxed);
+    PHASE.store(p, Ordering::Relaxed);
+    Guard(prev)
+}
